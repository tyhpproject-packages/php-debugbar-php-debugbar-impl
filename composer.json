{
    "name": "tyhpdef/php-debugbar-php-debugbar-impl",
    "description": "Implementation package for tyhpdef/php-debugbar-php-debugbar. Require tyhpdef/php-debugbar-php-debugbar, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.8.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-log": "@dev",
                "tyhpdef/symfony-var-dumper": "@dev",
                "tyhpdef/php-ext-pdo": "@dev",
                "tyhpdef/php-ext-memcached": "@dev",
                "tyhpdef/php-ext-redis": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/php-debugbar-php-debugbar"
        }
    },
    "require": {
        "php": ">=8.2",
        "php-debugbar/php-debugbar": "3.8.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-log": "@dev",
        "tyhpdef/symfony-var-dumper": "@dev",
        "tyhpdef/php-ext-pdo": "@dev",
        "tyhpdef/php-ext-memcached": "@dev",
        "tyhpdef/php-ext-redis": "@dev"
    }
}
